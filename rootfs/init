#!/bin/sh
# /init — QUADRA-OS boot init (initramfs)
# Mounts pseudo-filesystems, then starts the QUADRA-OS framebuffer desktop.
# Falls back to a root shell if the desktop cannot start.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin
export TERM=linux
export HOME=/root
export PS1='QUADRA-OS:\$ '

# Mount pseudo-filesystems (kernel auto-mounts devtmpfs at /dev thanks to
# CONFIG_DEVTMPFS_MOUNT=y)
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null

# Set hostname
hostname "$(cat /etc/hostname 2>/dev/null || echo quadra-os)" 2>/dev/null

# Quick console banner (visible in the boot log, harmless in fb mode)
echo "=== QUADRA-OS v1.0 ==="
cat /etc/motd 2>/dev/null

# If a framebuffer device exists, hand over to the desktop.
# (quadra-desktop renders the wallpaper, top bar, dock, windows.)
if [ -c /dev/fb0 ]; then
    exec /bin/quadra-desktop
fi

# Fallback: interactive root shell
cat /etc/motd 2>/dev/null
echo
echo "== Console =="
echo "  tty1: QUADRA-OS root shell"
echo "  Try:  ls /etc   free -h   df -h   uname -a   dmesg"
echo
exec /bin/sh -l
